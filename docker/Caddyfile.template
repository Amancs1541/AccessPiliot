{{HOST}} {
	{{TLS_DIRECTIVE}}
	encode gzip

	# Everything the backend actually serves - the API itself, its interactive docs, and the bare health check.
	# Everything else is the React SPA.
	@backend {
		path /api/* /health /docs /redoc /openapi.json
	}
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
